<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unilib_surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:text="@string/catalog_title"
        android:textColor="@color/unilib_primary"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_s"
        android:text="@string/catalog_programs"
        android:textColor="@color/unilib_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listPrograms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/unilib_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvEmptyPrograms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/catalog_no_programs"
            android:textColor="@color/unilib_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressPrograms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_s">

        <Button
            android:id="@+id/btnAddProgram"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/catalog_add_program" />

        <Button
            android:id="@+id/btnSeed"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/catalog_seed" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCourseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        android:text="@string/catalog_course_units"
        android:textColor="@color/unilib_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listCourses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/unilib_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvEmptyCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/catalog_no_course_units"
            android:textColor="@color/unilib_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnAddCourse"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_s"
        android:text="@string/catalog_add_course" />
</LinearLayout>
