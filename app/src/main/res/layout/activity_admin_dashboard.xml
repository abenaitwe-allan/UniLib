<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unilib_surface"
    android:orientation="vertical">

    <include
        layout="@layout/part_dashboard_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_s">

        <Button
            android:id="@+id/btnUpload"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_upload"
            android:textColor="@color/unilib_accent" />

        <Button
            android:id="@+id/btnAddAccount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_add_account"
            android:textColor="@color/unilib_accent" />

        <Button
            android:id="@+id/btnCatalog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_manage_catalog"
            android:textColor="@color/unilib_accent" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        android:text="@string/reviewer_pending"
        android:textColor="@color/unilib_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listPending"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/unilib_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvEmptyPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/reviewer_nothing_pending"
            android:textColor="@color/unilib_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        android:text="@string/admin_members"
        android:textColor="@color/unilib_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/unilib_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvEmptyUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/admin_no_members"
            android:textColor="@color/unilib_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
