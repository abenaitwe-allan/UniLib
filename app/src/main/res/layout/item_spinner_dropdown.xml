<?xml version="1.0" encoding="utf-8"?>
<!--
    One row inside the open dropdown list. Same reason as item_spinner.xml:
    the text colour is pinned so the option can always be read.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/unilib_card"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_m"
    android:textColor="@color/unilib_text"
    android:textColorHint="@color/unilib_text_secondary"
    android:textSize="@dimen/text_body" />
