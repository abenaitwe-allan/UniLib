<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unilib_surface"
    android:orientation="vertical">

    <include
        layout="@layout/part_dashboard_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpload"
        style="@style/UniLib.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_s"
        android:minWidth="0dp"
        android:text="@string/btn_upload" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_s"
        app:checkedButton="@id/btnTabLibrary"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabLibrary"
            style="@style/UniLib.Button.Toggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/president_tab_library" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabUploads"
            style="@style/UniLib.Button.Toggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/president_tab_uploads" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvSection"
        style="@style/UniLib.SectionHeader"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/president_tab_library" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listDocuments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/unilib_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/president_library_empty"
            android:textColor="@color/unilib_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
