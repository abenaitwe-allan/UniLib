<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashTopBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/unilib_primary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <TextView
        android:id="@+id/tvDashTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfile"
        style="@style/UniLib.Button.OutlinedLight"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:minWidth="0dp"
        android:text="Profile"
        app:icon="@drawable/ic_profile_person"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/UniLib.Button.OutlinedLight"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:text="@string/btn_logout" />
</LinearLayout>
